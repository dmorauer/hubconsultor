# Shared internal password for permitted @paytrack.com.br users.
# Store the real value only in the Vercel environment variables.
PAYTRACK_ACCESS_PASSWORD=
# Password for the owner account (douglas.morauer@paytrack.com.br), granted the "owner" role.
# Store the real value only in the Vercel environment variables.
PAYTRACK_OWNER_PASSWORD=
# Generate with: openssl rand -base64 32
AUTH_SECRET=

# Supabase project backing the Central de Implantação content (process_stages,
# process_templates, process_modules). Store real values only in Vercel.
NEXT_PUBLIC_SUPABASE_URL=
# Server-only. Never expose to the browser bundle or prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
